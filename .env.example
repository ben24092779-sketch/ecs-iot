# Plantilla de configuración — Supervisión IIoT Ender 3 Pro
# Copiar a .env, completar las credenciales reales y NO subir ese archivo a GitHub.

# PostgreSQL local (contenedor db)
POSTGRES_DB=ecs_iot
POSTGRES_USER=ecs_iot
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_POSTGRES
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django / login
DJANGO_SECRET_KEY=CAMBIAR_CLAVE_SECRETA_ALEATORIA
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=CAMBIAR_PASSWORD_ADMIN

# Variables MQTT heredadas para Mosquitto local (NO es el broker del montaje real)
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_USERNAME=ecs
MQTT_PASSWORD=CAMBIAR_PASSWORD_LOCAL
MQTT_TOPIC_PREFIX=ecs

# EMQX Cloud: usado por Django, mqtt_listener y plc_gateway
MQTT_CLOUD_BROKER_HOST=REEMPLAZAR_POR_HOST_EMQX
MQTT_CLOUD_BROKER_PORT=8883
MQTT_CLOUD_USERNAME=django-ender
MQTT_CLOUD_PASSWORD=REEMPLAZAR_PASSWORD_EMQX_DJANGO
MQTT_CLOUD_TLS_ENABLED=true
MQTT_CLOUD_CA_CERT=/app/certs/emqxsl-ca.crt

# Puertos del PC
WEB_HOST_PORT=8000
MOSQUITTO_HOST_PORT=1883

# PLC / Hito 9 — usar solamente cuando esté conectado físicamente en laboratorio
PLC_HOST=10.41.32.1
PLC_RACK=0
PLC_SLOT=1
PLC_DB_NUMBER=1
PLC_SYNC_INTERVAL=2

# false: leer PLC y mostrar cambios, pero NO enviar órdenes a EMQX.
# true: habilitar publicaciones de SP al broker; solo para pruebas supervisadas.
PLC_COMMANDS_ENABLED=false

# Compatibilidad con el simulador del proyecto base, que NO se usa en la demo final
SIMULATOR_DEVICE_TOKENS=

# Mapas heredados (función no requerida para esta entrega)
GOOGLE_MAPS_API_KEY=
